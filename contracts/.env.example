# ============================================================================
# contracts -- read automatically by `forge test` (Foundry loads ./contracts/.env).
# ============================================================================

# Base mainnet RPC the fork tests pin to. mainnet.base.org serves the historical state the
# tests need; base-rpc.publicnode.com refuses it without a paid token.
# (The Optimism and Arbitrum tests use public RPCs written into MultiChain.t.sol.)
BASE_RPC=https://mainnet.base.org
