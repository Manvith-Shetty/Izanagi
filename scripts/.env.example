# ============================================================================
# scripts -- the human's side. Read by scripts/railway-setup.sh (the production deploy),
# scripts/mainnet-setup.sh (a standalone wallet and channel), and by you when you run `cast`
# by hand (recover funds, inspect the wallet). No service reads it.
# ============================================================================

# --- REQUIRED for mainnet-setup.sh ------------------------------------------
# Your own key, funded on Base with a little ETH (~0.001) and some USDC. It becomes the
# wallet's OWNER: the only key that can open channels and recover funds.
OWNER_KEY=

# --- optional ---------------------------------------------------------------
RPC=https://mainnet.base.org
FUND=2000000                 # 2 USDC moved into the wallet
CHANNEL_DEPOSIT=500000       # 0.50 USDC escrowed in a tab to your own seller
GAS_TOPUP=0.0003ether        # sent to the oracle and the sellers claim key, each
# Where your demo seller's earnings land. Defaults to your own (owner) address.
SELLER_RECEIVER=

# --- railway-setup.sh: the production deploy (docs/deploy.md) ----------------
# A wallet of yours with ~0.002 ETH on Base. Used once, here, to deploy the deposit collector
# and give the service keys their gas. It never goes to Railway: Tab holds no key that owns or
# funds anyone's wallet.
FUNDER_KEY=
# The addresses, e.g. https://tab-production-xxxx.up.railway.app for the Tab service (the API
# and the MCP server), the seller service's for the demo shop, and https://NAME.vercel.app for
# the website. Any of them may be filled in later, in Railway's variables.
TAB_URL=
SHOP_URL=
SITE_URL=

# --- written by the setup scripts -------------------------------------------
COUNTERSIGN_WALLET=
COUNTERSIGN_COLLECTOR=
CHANNEL_ID=
