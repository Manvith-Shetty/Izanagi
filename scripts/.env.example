# ============================================================================
# scripts -- the human's side. Read by scripts/mainnet-setup.sh, and by you when
# you run `cast` by hand (recover funds, inspect the wallet). No service reads it.
# ============================================================================

# --- REQUIRED for mainnet-setup.sh ------------------------------------------
# Your own key, funded on Base with a little ETH (~0.001) and some USDC. It becomes the
# wallet's OWNER: the only key that can open channels and recover funds.
OWNER_KEY=

# --- optional ---------------------------------------------------------------
RPC=https://mainnet.base.org
FUND=2000000                 # 2 USDC moved into the wallet
CHANNEL_DEPOSIT=500000       # 0.50 USDC escrowed in a tab to your own seller
GAS_TOPUP=0.0003ether        # sent to the oracle and the sellers claim key, each
# Where your demo seller's earnings land. Defaults to your own (owner) address.
SELLER_RECEIVER=

# --- written by the setup scripts -------------------------------------------
COUNTERSIGN_WALLET=
COUNTERSIGN_COLLECTOR=
CHANNEL_ID=
