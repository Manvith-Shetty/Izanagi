# ============================================================================
# tab -- the API, the MCP server and (locally) the website. Read in exactly one place:
# tab/src/env.rs. On Railway these come from scripts/railway-setup.sh instead.
#
# Note what is NOT here: no Intercepta key, no World client secret, no countersigning key,
# and no key that owns or funds anyone's wallet. People create their wallet from their own
# MetaMask and add their own money; Tab only builds those transactions and checks them.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# The agent's hot key. Signs vouchers (worthless without a countersignature) and pays the
# gas to open tabs, which each wallet funds from its own balance. Needs a little ETH.
AGENT_PRIVATE_KEY=
# The countersigner's operator token (its CONTROL_TOKEN): lets Tab close tabs and ask a
# person to reopen one, never start a payment.
CONTROL_TOKEN=
# The shared deposit collector every wallet opens tabs through. It is written into each
# new wallet when the person creates it. Deployed by scripts/railway-setup.sh.
COUNTERSIGN_COLLECTOR=

# --- where things are -------------------------------------------------------
COUNTERSIGNER_URL=http://127.0.0.1:8787
# The website: page links and the login cookie belong to it. In production this is the
# Vercel site, which proxies /api here.
TAB_PUBLIC_URL=http://127.0.0.1:3000
# This server itself: MCP links point here directly. Defaults to TAB_PUBLIC_URL.
TAB_API_URL=
TAB_BIND=127.0.0.1:3000
# Our own demo shop (the `seller` crate), listed first in the catalog when set.
DEMO_SHOP_URL=

# --- chain ------------------------------------------------------------------
CHAIN_ID=8453
BASE_RPC=https://mainnet.base.org
# Mainnet reads for the network census, even when payments run on a fork.
CENSUS_RPC=https://mainnet.base.org
BLOCKSCOUT_API=https://base.blockscout.com/api

# --- limits (atomic USDC, 6 decimals) ---------------------------------------
TAB_DEPOSIT=50000             # 0.05 USDC: the opening deposit of a new tab
TAB_MAX_PRICE=100000          # 0.10 USDC: the most the agent pays for one call

# --- local paths (defaults shown) --------------------------------------------
# TAB_WEB_DIR=tab/web/dist
# TAB_STATE_DIR=tab/.state
