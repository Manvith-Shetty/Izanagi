# Everything here ships to the browser. URLs and the chain ID only -- secrets live in tab/.env.

# Where the owner's wallet sends transactions (pause, on-chain revoke).
VITE_RPC_URL=https://mainnet.base.org
VITE_CHAIN_ID=8453
# Block explorer for transaction links.
VITE_EXPLORER_URL=https://basescan.org

# Dev server only: where `npm run dev` forwards /api and /mcp.
TAB_DEV_PROXY=http://127.0.0.1:3000
