# ============================================================================
# seller -- an x402 `batch-settlement` endpoint for the demo.
# Read in exactly one place: seller/src/env.rs
#
# Serves GET /v1/data at a fixed price per call, screens every payer through
# Intercepta, and cashes vouchers in through Coinbase's deployed escrow.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# Where settled funds land (`payTo`).
SELLER_RECEIVER=
# The receiver authorizer: signs and sends claims, so it needs ETH for gas.
SELLER_AUTHORIZER_KEY=
# Screens every PAYER. Unset => every payer is refused. There is no mock mode,
# same as the countersigner: a guard that opens when its data source is down is
# not a guard. Free sandbox key: https://intercepta.io/ethglobal
INTERCEPTA_API_KEY=

# --- optional ---------------------------------------------------------------
SELLER_BIND=127.0.0.1:8080
SELLER_PUBLIC_URL=http://127.0.0.1:8080   # advertised in the 402s resource
SELLER_PRICE=10000            # 0.01 USDC per request, the live x402 Bazaar median
SELLER_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913   # USDC on Base
SELLER_TOKEN_NAME="USD Coin"  # the tokens own EIP-712 domain
SELLER_TOKEN_VERSION=2
SELLER_WITHDRAW_DELAY=900     # 15 min, the escrows minimum
CHAIN_ID=8453
BASE_RPC=https://mainnet.base.org

# How far to trust a payer (Intercepta toxicScore). A seller that serves first
# and claims later extends credit on every request; the score sets the line.
PAYER_REFUSE_AT=60            # >= this: not served
PAYER_CAREFUL_AT=30           # >= this: served, but claimed after every request
PAYER_SCREEN_CACHE_SECS=60

# When to cash vouchers in.
CLAIM_TICK_SECS=10
CLAIM_MARGIN_SECS=30          # claim this long before a Countersign attestation lapses
CLAIM_MAX_UNCLAIMED=1000000   # 1 USDC of unclaimed credit for a trusted payer
CLAIM_MAX_AGE_SECS=3600

# Enables POST /admin/claim (Authorization: Bearer <token>) to cash in now.
# Unset => the endpoint does not exist.
SELLER_ADMIN_TOKEN=

RUST_LOG=seller=info,countersign_seller=info
