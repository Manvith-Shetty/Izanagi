# ============================================================================
# countersigner -- the brain. Holds every secret and makes every decision.
# Read in exactly one place: countersigner/src/env.rs
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# The countersigning key. Holds a VETO, never the funds: on its own it cannot
# move money (the agent must also sign), cannot redirect it (the digest binds
# the channel, which binds the receiver), and cannot trap it (withdrawals are
# owner-only and need no oracle).
ORACLE_PRIVATE_KEY=

# --- Intercepta -------------------------------------------------------------
# Free sandbox key, 1,000 requests: https://intercepta.io/ethglobal
# If unset the policy engine FAILS CLOSED and refuses every payment. There is no
# mock mode: a guard that opens when its data source is down is not a guard.
INTERCEPTA_API_KEY=

# --- World ID for Agents ----------------------------------------------------
# Register a CONFIDENTIAL client at https://sandbox.auth.world.org/portal
# (Google sign-in). Dynamic registration and public clients are not supported.
# The secret is shown ONCE -- save it here immediately.
#
# A device-only client still needs a registered redirect URI even though the
# device grant never uses it. The redirect's HOSTNAME becomes the immutable
# "sector" that determines the pairwise `sub`, so changing it later changes
# every user's identifier. Loopback (http://localhost:PORT/...) is accepted.
#
# Unset => the human-approval path is disabled, so any `ask` verdict becomes a
# refusal rather than a silent pass.
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_ISSUER=https://sandbox.auth.world.org
# Enforce orb-level assurance when the IdP asserts an `acr`. The device grant
# cannot request acr_values, but World requires fresh proof for it regardless,
# so an absent acr is not treated as a failure.
WORLD_REQUIRE_ORB=true

# --- phone push (optional) --------------------------------------------------
# Set a topic to have `world_check` push the device code and the final verdict to
# a phone, so the approval can be tested away from the terminal. Install the ntfy
# app (or open https://ntfy.sh/<topic> in a browser) and subscribe to the same
# topic.
#
# The topic IS the credential: anyone who knows it can read every message and
# publish to it. Pick something unguessable, not "countersign".
#   NTFY_TOPIC=countersign-$(openssl rand -hex 4)
#
# Unset => no push, terminal only. Notifications are observability and never a
# control: a broker that is down cannot deny a payment, and an unreachable phone
# can never become an approval.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Only for a protected or self-hosted topic.
NTFY_TOKEN=
# Notification avatar. PNG or JPEG only -- an .ico is silently ignored by the
# phone app. Set it empty to send no icon.
NTFY_ICON=https://github.com/worldcoin.png?size=200

# --- policy (atomic USDC, 6 decimals: 20000000 = 20 USDC) -------------------
AUTONOMOUS_LIMIT=20000000     # below this, a clean counterparty needs no human
HUMAN_LIMIT=500000000         # per PERSON (pairwise sub), across all their agents
ATTESTATION_TTL=120           # short, so declining to re-issue is itself a revocation
RESCREEN_SECS=60              # how often open sessions are re-screened (1 Intercepta call per open seller)
REFUSE_AT=60                  # toxicScore >= this -> refuse
ASK_AT=30                     # toxicScore >= this -> ask a human
CAP_AT=10                     # toxicScore >= this -> cap the amount
CAPPED_CEILING=1000000        # 1 USDC, the ceiling applied when capping
MAX_PRICE=100000000           # price sanity; the live x402 Bazaar median is 0.01 USDC
APPROVAL_STEP=0               # a person raises a tabs limit in steps of this; 0 = AUTONOMOUS_LIMIT
ADDRESS_CACHE_SECS=30         # a sellers score is reused this long between payments
TOKEN_CACHE_SECS=3600         # a tokens trust verdict is reused this long

# --- the on-chain kill switch -----------------------------------------------
# The chain the guarded wallets live on. The oracle key above must hold a little ETH
# there: it sends `revoke` when a tab is closed and `restore` after a person approves.
# Unset => closing a tab still stops countersigning (outstanding attestations lapse within
# ATTESTATION_TTL), but nothing is written to the wallet.
BASE_RPC=

# --- the operator API (dashboard, Tab, manual curl) ------------------------
# Bearer token for revoke / restore / activity / stream / screen. 16+ characters.
# Unset => that API does not exist. Tab needs the same value.
#   CONTROL_TOKEN=$(openssl rand -hex 16)
CONTROL_TOKEN=
# Base URL of the page that shows a person what they are approving; pushes link to
# {url}/approve/{id}. Unset => pushes link straight to World's own page.
APPROVAL_PAGE_URL=
# Where durable state lives: which World ID each wallet is bound to.
STATE_DIR=

# --- service ----------------------------------------------------------------
BIND=127.0.0.1:8787
RUST_LOG=countersigner=info,common=info
